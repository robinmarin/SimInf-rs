Package: siminfr
Title: R Bindings to the SimInf-rs Stochastic Disease Spread Solver
Version: 0.3.0
Authors@R: c(person("Robin", "Eriksson", role = c("aut", "cre"),
                     email = "robin.eriksson@somewhere.org"))
Description: Provides R bindings to siminf-core, a Rust implementation of
    the Gillespie stochastic simulation algorithm for disease spread
    models. Uses the original SimInf package as a reference for API
    design and numerical validation.
License: GPL-3
URL: https://github.com/re/SimInf-rs
Depends: R (>= 4.0)
Imports:
    methods,
    stats,
    utils,
    Matrix (>= 1.3-0)
NeedsCompilation: yes
LazyData: true
Collate:
    'classes.R'
    'SimInf_events.R'
    'SimInf_model.R'
    'SIR.R'
    'SEIR.R'
    'SIS.R'
    'run.R'
    'trajectory.R'
    'mparse.R'
